<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Header: Weather info scrolls away -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/weather_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Menu button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/MenuButton"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:padding="12dp"
                android:contentDescription="@string/open_menu"
                app:icon="@drawable/mas"
                app:iconTint="@color/black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- City name -->
            <TextView
                android:id="@+id/locationTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/location_default"
                android:textSize="30sp"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/MenuButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Date/time -->
            <TextView
                android:id="@+id/dateTimeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/date_time_default"
                android:textSize="15sp"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/locationTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Weather icon -->
            <ImageView
                android:id="@+id/weatherIconImageView"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/weatherly"
                android:contentDescription="@string/weatherIcon"
                app:layout_constraintTop_toBottomOf="@id/dateTimeTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Temperature -->
            <TextView
                android:id="@+id/temperatureTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/temperature_default"
                android:textSize="45sp"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/weatherIconImageView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Greeting -->
            <TextView
                android:id="@+id/greetingTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/goodMorning"
                android:textSize="20sp"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/temperatureTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Separator line -->
            <ImageView
                android:id="@+id/horizontalLine"
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:background="@color/black"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/greetingTextView"
                tools:ignore="ImageContrastCheck" />

            <!-- Icons row -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ivSunrise"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:padding="0dp"
                android:contentDescription="@string/sunsetIcon"
                app:icon="@drawable/sunset"
                app:iconTint="@color/black"
                app:iconSize="40dp"
                app:layout_constraintTop_toBottomOf="@id/horizontalLine"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivWind"
                app:layout_constraintHorizontal_chainStyle="spread" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ivWind"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:padding="0dp"
                android:contentDescription="@string/windIcon"
                app:icon="@drawable/air_24px"
                app:iconTint="@color/black"
                app:iconSize="38dp"
                app:layout_constraintTop_toBottomOf="@id/horizontalLine"
                app:layout_constraintStart_toEndOf="@id/ivSunrise"
                app:layout_constraintEnd_toStartOf="@id/ivTemperature" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ivTemperature"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:padding="0dp"
                android:contentDescription="@string/temperatureIcon"
                app:icon="@drawable/temperature"
                app:iconTint="@color/black"
                app:iconSize="48dp"
                app:layout_constraintTop_toBottomOf="@id/horizontalLine"
                app:layout_constraintStart_toEndOf="@id/ivWind"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Labels under icons -->
            <TextView
                android:id="@+id/sunsetLabelTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sunset"
                android:textStyle="bold"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/ivSunrise"
                app:layout_constraintStart_toStartOf="@id/ivSunrise"
                app:layout_constraintEnd_toEndOf="@id/ivSunrise" />

            <TextView
                android:id="@+id/windLabelTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:text="@string/wind"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/ivWind"
                app:layout_constraintStart_toStartOf="@id/ivWind"
                app:layout_constraintEnd_toEndOf="@id/ivWind" />

            <TextView
                android:id="@+id/temperatureLabelTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/temperature"
                android:textStyle="bold"

                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/ivTemperature"
                app:layout_constraintStart_toStartOf="@id/ivTemperature"
                app:layout_constraintEnd_toEndOf="@id/ivTemperature" />

            <!-- Values under labels -->
            <TextView
                android:id="@+id/sunsetTimeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sunset_time_default"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/sunsetLabelTextView"
                app:layout_constraintStart_toStartOf="@id/sunsetLabelTextView"
                app:layout_constraintEnd_toEndOf="@id/sunsetLabelTextView" />

            <TextView
                android:id="@+id/windSpeedTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/windInfo"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/windLabelTextView"
                app:layout_constraintStart_toStartOf="@id/windLabelTextView"
                app:layout_constraintEnd_toEndOf="@id/windLabelTextView" />

            <TextView
                android:id="@+id/temperatureSecondTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/temperature_second_default"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/temperatureLabelTextView"
                app:layout_constraintStart_toStartOf="@id/temperatureLabelTextView"
                app:layout_constraintEnd_toEndOf="@id/temperatureLabelTextView" />

            <TextView
                android:id="@+id/forecastHeaderTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ForecastTittle"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/temperatureSecondTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>


    <!-- Forecast list: scrolls under header -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvForecast"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:contentDescription="@string/forecast_list_description"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_forecast" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
