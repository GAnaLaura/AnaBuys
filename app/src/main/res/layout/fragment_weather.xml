<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/MenuButton"
            style="?attr/materialIconButtonStyle"
            android:layout_width="20dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:contentDescription=""
            android:insetLeft="-10dp"
            android:scaleX="2"
            android:scaleY="2"
            app:icon="@drawable/mas"
            app:iconTint="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:gravity="center_horizontal"
            android:text="Karachi"
            android:textSize="30sp"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="176dp" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:text="22°C"
            android:textSize="45sp"
            app:layout_constraintTop_toBottomOf="@+id/imageView3"
            tools:layout_editor_absoluteX="0dp" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="GOOD MORNING\nWASIM"
            android:textSize="20dp"
            app:layout_constraintTop_toBottomOf="@+id/textView3"
            tools:layout_editor_absoluteX="0dp" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="WIND"
            android:textSize="10dp"
            app:layout_constraintTop_toBottomOf="@+id/sunset"
            tools:layout_editor_absoluteX="193dp" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="TEMPERATURE"
            android:textSize="10dp"
            app:layout_constraintTop_toBottomOf="@+id/sunset3"
            tools:layout_editor_absoluteX="299dp" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="SUNSET"
            android:textSize="10dp"
            app:layout_constraintTop_toBottomOf="@+id/sunset2"
            tools:layout_editor_absoluteX="58dp" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal"
            android:text="4m/s"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView6"
            app:layout_constraintVertical_bias="1.0"
            tools:layout_editor_absoluteX="181dp" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal"
            android:text="23°C"
            android:textSize="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/verticalLine2"
            app:layout_constraintTop_toBottomOf="@+id/textView11" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal"
            android:text="7:00"
            android:textSize="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/verticalLine"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView10" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="MONDAY 7:00 AM"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            tools:layout_editor_absoluteX="176dp" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@+id/textView2"
            tools:layout_editor_absoluteX="80dp"
            tools:src="@tools:sample/avatars" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:src="@drawable/line"
            app:layout_constraintTop_toBottomOf="@+id/textView5"
            tools:layout_editor_absoluteX="193dp" />

        <Button
            android:id="@+id/sunset"
            style="?attr/materialIconButtonStyle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:contentDescription=""
            android:gravity="center_horizontal"
            android:insetLeft="-5dp"
            android:scaleX="1.4"
            android:scaleY="1.4"
            app:icon="@drawable/sunset"
            app:iconTint="@color/black"
            app:layout_constraintTop_toBottomOf="@+id/imageView4"
            tools:layout_editor_absoluteX="190dp" />

        <Button
            android:id="@+id/sunset3"
            style="?attr/materialIconButtonStyle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription=""
            android:gravity="center_horizontal"
            android:insetLeft="-5dp"
            android:scaleX="1.4"
            android:scaleY="1.4"
            app:icon="@drawable/temperature"
            app:iconTint="@color/black"
            tools:layout_editor_absoluteX="318dp"
            tools:layout_editor_absoluteY="626dp" />

        <Button
            android:id="@+id/sunset2"
            style="?attr/materialIconButtonStyle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription=""
            android:gravity="center_horizontal"
            android:insetLeft="-5dp"
            android:scaleX="1.4"
            android:scaleY="1.4"
            app:icon="@drawable/sunset"
            app:iconTint="@color/black"
            tools:layout_editor_absoluteX="58dp"
            tools:layout_editor_absoluteY="626dp" />

        <ImageView
            android:id="@+id/horizontalLine"
            android:layout_width="24dp"
            android:layout_height="25dp"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:src="@drawable/line"
            app:layout_constraintTop_toBottomOf="@+id/textView5"
            tools:layout_editor_absoluteX="193dp" />

        <ImageView
            android:id="@+id/verticalLine"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_horizontal"
            android:scaleY="1.5"
            android:src="@drawable/vertical"
            app:layout_constraintEnd_toStartOf="@+id/textView7"
            tools:layout_editor_absoluteY="688dp" />

        <ImageView
            android:id="@+id/verticalLine2"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="8dp"
            android:gravity="center_horizontal"
            android:scaleY="1.5"
            android:src="@drawable/vertical"
            app:layout_constraintStart_toEndOf="@+id/textView7"
            tools:layout_editor_absoluteY="688dp" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>